<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="400.0"
            minWidth="600.0"
            prefHeight="400.0"
            prefWidth="600.0"
            stylesheets="@style.css"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.csc325.librarymanagementsystem.controller.MainController">

    <children>

        <BorderPane AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="0.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0">

            <top>
                <HBox alignment="CENTER_LEFT"
                      prefHeight="55.0"
                      prefWidth="600.0"
                      styleClass="top-bar">

                    <children>
                        <Region prefWidth="10.0" />

                        <Label text="Library" styleClass="app-title" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Label fx:id="welcomeLabel"
                               text="Welcome, John!"
                               styleClass="top-subtitle" />

                        <Region prefWidth="16.0" />

                        <Button fx:id="notificationButton"
                                text="Notifications"
                                mnemonicParsing="false"
                                styleClass="top-button"
                                prefHeight="55.0"
                                prefWidth="86.0" />

                        <Region prefWidth="8.0" />
                    </children>
                </HBox>
            </top>

            <left>
                <VBox prefHeight="345.0"
                      prefWidth="156.0"
                      styleClass="side-bar">

                    <padding>
                        <Insets left="10.0" top="10.0" />
                    </padding>

                    <children>

                        <Label text="MENU" styleClass="menu-label" />

                        <Separator prefWidth="164.0">
                            <VBox.margin>
                                <Insets bottom="4.0" top="4.0" />
                            </VBox.margin>
                        </Separator>

                        <Button fx:id="homeButton"
                                text="Home"
                                mnemonicParsing="false"
                                prefHeight="34.0"
                                prefWidth="143.0"
                                styleClass="menu-button-active" />

                        <Button fx:id="searchButton"
                                text="Search Books"
                                mnemonicParsing="false"
                                onAction="#searchButtonOnAction"
                                prefHeight="34.0"
                                prefWidth="143.0"
                                styleClass="menu-button" />

                        <Button fx:id="cartButton"
                                text="My Cart"
                                mnemonicParsing="false"
                                onAction="#onCartClicked"
                                prefHeight="34.0"
                                prefWidth="143.0"
                                styleClass="menu-button" />

                        <Button fx:id="loansButton"
                                text="Active Loans"
                                mnemonicParsing="false"
                                onAction="#onLoansClicked"
                                prefHeight="34.0"
                                prefWidth="143.0"
                                styleClass="menu-button" />

                        <Button fx:id="checkoutButton"
                                text="Checkout"
                                mnemonicParsing="false"
                                onAction="#onCheckoutClicked"
                                prefHeight="34.0"
                                prefWidth="143.0"
                                styleClass="menu-button" />

                        <Region VBox.vgrow="ALWAYS" />

                        <Separator prefWidth="164.0">
                            <VBox.margin>
                                <Insets bottom="4.0" />
                            </VBox.margin>
                        </Separator>

                        <Button fx:id="profileButton"
                                text="Profile"
                                mnemonicParsing="false"
                                onAction="#onProfileClicked"
                                prefHeight="34.0"
                                prefWidth="143.0"
                                styleClass="menu-button" />

                        <Button fx:id="settingsButton"
                                text="Settings"
                                mnemonicParsing="false"
                                onAction="#onSettingsClicked"
                                prefHeight="34.0"
                                prefWidth="143.0"
                                styleClass="menu-button" />

                        <Button fx:id="signOutButton"
                                text="Sign Out"
                                mnemonicParsing="false"
                                onAction="#onSignOutClicked"
                                prefHeight="34.0"
                                prefWidth="143.0"
                                styleClass="sign-out-button" />

                    </children>
                </VBox>
            </left>

            <center>
                <VBox prefHeight="345.0"
                      prefWidth="444.0"
                      spacing="16.0"
                      styleClass="content-pane">

                    <padding>
                        <Insets bottom="24.0"
                                left="24.0"
                                right="24.0"
                                top="24.0" />
                    </padding>

                    <children>

                        <Label text="Welcome to the Library!"
                               styleClass="page-title" />

                        <Label text="What would you like to do today?"
                               styleClass="page-subtitle" />

                        <Separator />

                        <HBox spacing="16.0">

                            <children>

                                <VBox prefWidth="185.0"
                                      spacing="10.0"
                                      styleClass="search-card">

                                    <children>

                                        <Label text="MOST LOANED BOOK"
                                               styleClass="menu-label" />

                                        <HBox alignment="CENTER_LEFT"
                                              spacing="12.0">

                                            <children>

                                                <ImageView fx:id="mostLoanedImage"
                                                           fitHeight="110.0"
                                                           fitWidth="80.0"
                                                           preserveRatio="true" />

                                                <VBox alignment="CENTER_LEFT"
                                                      spacing="6.0">

                                                    <children>

                                                        <Label fx:id="mostLoanedTitle"
                                                               text="Book Title"
                                                               wrapText="true"
                                                               styleClass="card-title" />

                                                        <Label fx:id="mostLoanedAuthor"
                                                               text="Author Name"
                                                               styleClass="page-subtitle" />

                                                        <Label fx:id="mostLoanedCount"
                                                               text="0 active loans"
                                                               styleClass="small-muted" />

                                                    </children>
                                                </VBox>

                                            </children>
                                        </HBox>

                                    </children>
                                </VBox>

                                <VBox prefWidth="185.0"
                                      spacing="10.0"
                                      styleClass="search-card">

                                    <children>

                                        <Label text="BOOK OF THE DAY"
                                               styleClass="menu-label" />

                                        <HBox alignment="CENTER_LEFT"
                                              spacing="12.0">

                                            <children>

                                                <ImageView fx:id="bookOfDayImage"
                                                           fitHeight="110.0"
                                                           fitWidth="80.0"
                                                           preserveRatio="true" />

                                                <VBox alignment="CENTER_LEFT"
                                                      spacing="6.0">

                                                    <children>

                                                        <Label fx:id="bookOfDayTitle"
                                                               text="Book Title"
                                                               wrapText="true"
                                                               styleClass="card-title" />

                                                        <Label fx:id="bookOfDayAuthor"
                                                               text="Author Name"
                                                               styleClass="page-subtitle" />

                                                        <Label fx:id="bookOfDayGenre"
                                                               text="Random pick of the day"
                                                               styleClass="small-muted" />

                                                    </children>
                                                </VBox>

                                            </children>
                                        </HBox>

                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                    </children>
                </VBox>
            </center>

        </BorderPane>

    </children>
</AnchorPane>