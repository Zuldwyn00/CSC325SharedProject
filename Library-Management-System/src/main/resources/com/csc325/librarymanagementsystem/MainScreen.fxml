<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="400.0" minWidth="600.0" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #333333;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.csc325.librarymanagementsystem.controller.MainController">
   <children>
      <BorderPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

         <top>
            <HBox alignment="CENTER_LEFT" prefHeight="55.0" prefWidth="600.0" style="-fx-background-color: #223355;" BorderPane.alignment="CENTER">
               <children>
                  <Region prefWidth="10.0" />
                  <Label text="Library" textFill="WHITE">
                     <font><Font name="System Bold" size="15.0" /></font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="welcomeLabel" text="Welcome, John!" textFill="#CBD5E1">
                     <font><Font size="13.0" /></font>
                  </Label>
                  <Region prefWidth="16.0" />
                  <Button fx:id="notificationButton" mnemonicParsing="false" prefHeight="55.0" prefWidth="86.0" style="-fx-background-color: TRANSPARENT; -fx-text-fill: WHITE; -fx-font-size: 12px;" text="Notifications" />
                  <Region prefWidth="8.0" />
               </children>
            </HBox>
         </top>

         <left>
            <VBox prefHeight="345.0" prefWidth="156.0" style="-fx-background-color: #2a2a2a;" BorderPane.alignment="CENTER">
               <padding><Insets left="10.0" top="10.0" /></padding>
               <children>
                  <Label text="MENU" textFill="#a8a8a8">
                     <font><Font name="System Bold" size="11.0" /></font>
                  </Label>
                  <Separator prefWidth="164.0">
                     <VBox.margin><Insets bottom="4.0" top="4.0" /></VBox.margin>
                  </Separator>
                  <Button fx:id="searchButton" mnemonicParsing="false" onAction="#searchButtonOnAction" prefHeight="34.0" prefWidth="143.0" style="-fx-background-color: #3d3d3d; -fx-alignment: CENTER-LEFT;" text="Search Books" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
                  <Button fx:id="cartButton" mnemonicParsing="false" onAction="#onCartClicked" prefHeight="34.0" prefWidth="143.0" style="-fx-background-color: TRANSPARENT; -fx-alignment: CENTER-LEFT;" text="My Cart" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
                  <Button fx:id="loansButton" mnemonicParsing="false" onAction="#onLoansClicked" prefHeight="34.0" prefWidth="143.0" style="-fx-background-color: TRANSPARENT; -fx-alignment: CENTER-LEFT;" text="Active Loans" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
                  <Button fx:id="checkoutButton" mnemonicParsing="false" onAction="#onCheckoutClicked" prefHeight="34.0" prefWidth="143.0" style="-fx-background-color: TRANSPARENT; -fx-alignment: CENTER-LEFT;" text="Checkout" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
                  <Region VBox.vgrow="ALWAYS" />
                  <Separator prefWidth="164.0">
                     <VBox.margin><Insets bottom="4.0" /></VBox.margin>
                  </Separator>
                  <Button fx:id="profileButton" mnemonicParsing="false" onAction="#onProfileClicked" prefHeight="34.0" prefWidth="143.0" style="-fx-background-color: TRANSPARENT; -fx-alignment: CENTER-LEFT;" text="Profile" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
                  <Button fx:id="settingsButton" mnemonicParsing="false" onAction="#onSettingsClicked" prefHeight="34.0" prefWidth="143.0" style="-fx-background-color: TRANSPARENT; -fx-alignment: CENTER-LEFT;" text="Settings" textFill="WHITE">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
                  <Button fx:id="signOutButton" mnemonicParsing="false" onAction="#onSignOutClicked" prefHeight="34.0" prefWidth="143.0" style="-fx-background-color: TRANSPARENT; -fx-alignment: CENTER-LEFT;" text="Sign Out" textFill="#e44848">
                     <font><Font name="System Bold" size="13.0" /></font>
                  </Button>
               </children>
            </VBox>
         </left>

         <center>
            <VBox prefHeight="345.0" prefWidth="444.0" spacing="16.0" style="-fx-background-color: #333333;" BorderPane.alignment="CENTER">
               <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
               <children>
                  <Label text="Welcome to the Library!" textFill="WHITE">
                     <font><Font name="System Bold" size="22.0" /></font>
                  </Label>
                  <Label text="What would you like to do today?" textFill="#a8a8a8">
                     <font><Font size="13.0" /></font>
                  </Label>
                  <Separator />
                  <HBox spacing="16.0">
                     <children>

                        <VBox prefWidth="185.0" spacing="10.0" style="-fx-border-color: #555555; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #3d3d3d; -fx-padding: 14;">
                           <children>
                              <Label text="MOST LOANED BOOK" textFill="#a8a8a8">
                                 <font><Font name="System Bold" size="11.0" /></font>
                              </Label>
                              <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <children>
                                    <ImageView fx:id="mostLoanedImage" fitHeight="110.0" fitWidth="80.0" preserveRatio="true" />
                                    <VBox alignment="CENTER_LEFT" spacing="6.0">
                                       <children>
                                          <Label fx:id="mostLoanedTitle" text="Book Title" textFill="WHITE" wrapText="true">
                                             <font><Font name="System Bold" size="14.0" /></font>
                                          </Label>
                                          <Label fx:id="mostLoanedAuthor" text="Author Name" textFill="#a8a8a8">
                                             <font><Font size="12.0" /></font>
                                          </Label>
                                          <Label fx:id="mostLoanedCount" text="0 active loans" textFill="#666666">
                                             <font><Font size="11.0" /></font>
                                          </Label>
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <VBox prefWidth="185.0" spacing="10.0" style="-fx-border-color: #555555; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #3d3d3d; -fx-padding: 14;">
                           <children>
                              <Label text="BOOK OF THE DAY" textFill="#a8a8a8">
                                 <font><Font name="System Bold" size="11.0" /></font>
                              </Label>
                              <HBox alignment="CENTER_LEFT" spacing="12.0">
                                 <children>
                                    <ImageView fx:id="bookOfDayImage" fitHeight="110.0" fitWidth="80.0" preserveRatio="true" />
                                    <VBox alignment="CENTER_LEFT" spacing="6.0">
                                       <children>
                                          <Label fx:id="bookOfDayTitle" text="Book Title" textFill="WHITE" wrapText="true">
                                             <font><Font name="System Bold" size="14.0" /></font>
                                          </Label>
                                          <Label fx:id="bookOfDayAuthor" text="Author Name" textFill="#a8a8a8">
                                             <font><Font size="12.0" /></font>
                                          </Label>
                                          <Label fx:id="bookOfDayGenre" text="Random pick of the day" textFill="#666666">
                                             <font><Font size="11.0" /></font>
                                          </Label>
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                     </children>
                  </HBox>
               </children>
            </VBox>
         </center>

      </BorderPane>
   </children>
</AnchorPane>
