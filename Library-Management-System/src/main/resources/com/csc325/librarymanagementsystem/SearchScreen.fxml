<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #F5F5F5;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.csc325.librarymanagementsystem.controller.SearchController">

    <children>

        <HBox spacing="10" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <Button fx:id="backToScreenButton" mnemonicParsing="false" onAction="#onBackToScreen" prefHeight="26.0" prefWidth="46.0" text="Back" textAlignment="CENTER">
            <opaqueInsets>
               <Insets />
            </opaqueInsets>
         </Button>

            <TextField fx:id="SearchTextField" promptText="Search..." HBox.hgrow="ALWAYS" />

            <Button fx:id="searchButton" mnemonicParsing="false" onAction="#searchButtonOnAction" text="Search" />

            <ChoiceBox fx:id="SearchTypeChoice" prefWidth="150.0" />

        </HBox>

        <ListView fx:id="resultsList" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="70.0" />

    </children>
</AnchorPane>
